[Unit]
Description=Turkish Medicine API Scheduler (Weekly Updates)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/path/to/turkish-medicine-api
Environment=NODE_ENV=production
ExecStart=/usr/bin/node src/scheduler.js
Restart=on-failure
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=turkish-medicine-scheduler

[Install]
WantedBy=multi-user.target
